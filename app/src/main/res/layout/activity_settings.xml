<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF06101C"
    android:padding="12dp">

    <!-- Top tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="bottom">

        <TextView
            android:id="@+id/tab_juego"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:background="@drawable/bg_tab_idle"
            android:text="JUEGO"
            android:textColor="#88AACC"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tab_camara"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:background="@drawable/bg_tab_idle"
            android:text="CÁMARA"
            android:textColor="#88AACC"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tab_controles"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:background="@drawable/bg_tab_selected"
            android:text="CONTROLES"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tab_interfaz"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_tab_idle"
            android:text="INTERFAZ"
            android:textColor="#88AACC"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_settings_panel"
        android:padding="10dp">

        <!-- Left nav -->
        <LinearLayout
            android:layout_width="160dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CONFIGURACIÓN"
                android:textColor="#FF40B8FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:paddingBottom="10dp" />

            <TextView
                android:id="@+id/nav_keybinds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:background="@drawable/bg_nav_selected"
                android:text="⌨  ASIGNACIÓN DE TECLAS"
                android:textColor="#FFE8F4FF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Right content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ASIGNACIÓN DE TECLAS"
                android:textColor="#FFE8F4FF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/hint_listen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Toca un binding y pulsa una tecla o botón del mando."
                android:textColor="#88AACC"
                android:textSize="11sp"
                android:paddingBottom="6dp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/bind_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <!-- Side tip panel -->
        <LinearLayout
            android:layout_width="140dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Personaliza las teclas para un control más cómodo y rápido en el juego."
                android:textColor="#99BBDD"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="⌨  |  🎮"
                android:textColor="#FF40B8FF"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Juega a tu manera"
                android:textColor="#88AACC"
                android:textSize="11sp"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="start">

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:gravity="center"
            android:background="@drawable/bg_button_blue"
            android:text="←  VOLVER"
            android:textColor="#FFE8F4FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_reset"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:gravity="center"
            android:background="@drawable/bg_button_blue"
            android:text="RESTABLECER POR DEFECTO"
            android:textColor="#FFE8F4FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
